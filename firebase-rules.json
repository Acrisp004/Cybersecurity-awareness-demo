{
  "rules": {
    "classroomSessions": {
      ".read": "auth != null && auth.uid === 'REPLACE_WITH_YOUR_PRESENTER_UID' && auth.token.firebase.sign_in_provider === 'google.com'",
      "$sessionId": {
        ".write": "auth != null && auth.uid === $sessionId && auth.token.firebase.sign_in_provider === 'anonymous'",
        ".validate": "newData.hasChildren(['startedAt','updatedAt','status','fields'])",
        "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "status": { ".validate": "newData.isString() && newData.val() === 'editing'" },
        "fields": {
          ".validate": "newData.hasChildren(['fullName','email','phone','street','city','state','zip'])",
          "fullName": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 256" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 256" },
            "$other": { ".validate": false }
          },
          "email": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 256" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 256" },
            "$other": { ".validate": false }
          },
          "phone": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 64" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64" },
            "$other": { ".validate": false }
          },
          "street": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 256" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 256" },
            "$other": { ".validate": false }
          },
          "city": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 128" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 128" },
            "$other": { ".validate": false }
          },
          "state": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 64" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64" },
            "$other": { ".validate": false }
          },
          "zip": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value":  { ".validate": "newData.isString() && newData.val().length <= 32" },
            "length": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
