{
  "rules": {
    "classroomSessions": {
      ".read": "auth != null && auth.uid === 'uf3pslQ1hOTtsU7m2ezX0OQSPg53' && auth.token.firebase.sign_in_provider === 'google.com'",
      "$sessionId": {
        ".write": "auth != null && auth.uid === $sessionId && auth.token.firebase.sign_in_provider === 'anonymous'",
        ".validate": "newData.hasChildren(['startedAt','updatedAt','status','fields'])",
        "startedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "status": {
          ".validate": "newData.isString() && newData.val() === 'editing'"
        },
        "fields": {
          ".validate": "newData.hasChildren(['fullName','email','phone','street','city','state','zip'])",
          "fullName": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'Anthony' || newData.val() === 'Jordan' || newData.val() === 'Taylor Example')"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
            },
            "$other": {
              ".validate": false
            }
          },
          "email": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[a-z0-9._-]{1,24}@example\\.(com|org|net)$/))"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
            },
            "$other": {
              ".validate": false
            }
          },
          "phone": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[2-9][0-9]{2}-555-01[0-9]{2}$/))"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
            },
            "$other": {
              ".validate": false
            }
          },
          "street": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{1,4} (Example|Sample|Demo) [A-Za-z ]{1,30}$/))"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
            },
            "$other": {
              ".validate": false
            }
          },
          "city": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^(Sample|Example|Demo) [A-Za-z ]{0,24}$/))"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
            },
            "$other": {
              ".validate": false
            }
          },
          "state": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'NE' || newData.val() === 'ZZ')"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            },
            "$other": {
              ".validate": false
            }
          },
          "zip": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val() === '00000' || newData.val() === '99999')"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "$other": {
              ".validate": false
            }
          },
          "cardCode": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val() === '1234' || newData.val() === '5678' || newData.val() === '0000')"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
            },
            "$other": {
              ".validate": false
            }
          },
          "expiry": {
            ".validate": "newData.hasChildren(['value','length'])",
            "value": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val() === '12/30' || newData.val() === '01/31')"
            },
            "length": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
